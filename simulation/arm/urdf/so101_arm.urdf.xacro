<?xml version="1.0" ?>
<!--
SO-101 比赛改型机械臂：本体 + 当前末端，不含腕部相机。
本文件由仓库 src/so-101_description 整理而来，已经展开为单文件，不依赖其他 Xacro。
-->
<robot name="so101_arm">
  <!-- ===== base_footprint: 世界根节点 ===== -->
  <link name="base_footprint"/>
  <!-- rpy="-1.5708 0 0" 使臂体从 CAD 水平转为竖直站立
         base_link Y → world -Z, base_link Z → world Y
         J1 轴用 base_link Y → world Z (yaw) -->
  <joint name="base_orientation_joint" type="fixed">
    <origin rpy="-1.5707963 0 0" xyz="0 0 0.045"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>
  <!-- ============================================ -->
  <!-- base_link (CAD: base_link) — 底座              -->
  <!-- ============================================ -->
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0000096 0.014495 0.012489"/>
      <mass value="0.14723"/>
      <inertia ixx="0.00013418" ixy="-0.00000001" ixz="0.00000004" iyy="0.00017400" iyz="0.00002337" izz="0.00016382"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0 0.036394 -0.010422"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_001_Wiring_holder_v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="so101_dark">
        <color rgba="0.3 0.3 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0" xyz="0 0.036394 -0.010422"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_001_Wiring_holder_v1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- ============================================ -->
  <!-- shoulder (CAD: Rotation_Pitch) — 肩部          -->
  <!-- 嵌入舵机 mesh: part_086(舵机1) + part_085(舵机0)  -->
  <!-- 原始CAD: driver_1 和 driver_0 均在 [0,0,0] 叠加   -->
  <!-- ============================================ -->
  <link name="shoulder">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.000258 -0.058004 -0.038910"/>
      <mass value="0.082067"/>
      <inertia ixx="0.00005789" ixy="-0.00000041" ixz="-0.00000001" iyy="0.00002429" iyz="-0.00000557" izz="0.00005184"/>
    </inertial>
    <!-- 肩部主体 -->
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_002_Wiring_holder_v1_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="so101_dark">
        <color rgba="0.3 0.3 0.35 1.0"/>
      </material>
    </visual>
    <!-- 舵机1 (part_086): driver_1_joint origin [0,0,0] from shoulder -->
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_086_1653192640.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="servo_grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <!-- 舵机0 (part_085): driver_0_joint origin [0,0,0] from driver_1 = 同位置叠加 -->
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_085_Extruded_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="servo_grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_002_Wiring_holder_v1_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- J1: 底座 → 肩部 (yaw). 轴=Y 使经 base_footprint 旋转后绕世界 Z -->
  <joint name="J1_Rotation" type="revolute">
    <origin rpy="0 0 0" xyz="0 0.036394 -0.010422"/>
    <parent link="base_link"/>
    <child link="shoulder"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" lower="-1.57" upper="1.57" velocity="5"/>
    <dynamics damping="0.1"/>
  </joint>
  <!-- ============================================ -->
  <!-- arm_upper (CAD: under_arm) — 大臂              -->
  <!-- 嵌入舵机 mesh: part_087(舵机2)                   -->
  <!-- CAD: driver_2_joint origin [0.0237,0.1198,0.0389] -->
  <!-- ============================================ -->
  <link name="arm_upper">
    <inertial>
      <origin rpy="0 0 0" xyz="0.025164 -0.000131 0.060915"/>
      <mass value="0.14017"/>
      <inertia ixx="0.00017080" ixy="-0.00000006" ixz="0.00000255" iyy="0.00021880" iyz="-0.00000104" izz="0.00006087"/>
    </inertial>
    <!-- 大臂主体 -->
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0.023656 0.119757 0.038947"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_003_Wiring_holder_v1_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="so101_mid">
        <color rgba="0.25 0.35 0.45 1.0"/>
      </material>
    </visual>
    <!-- 舵机2 (part_087): 在 driver_2_joint 处 [0.0237,0.1198,0.0389] -->
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0.023656 0.119757 0.038947"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_087_736125216.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="servo_grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0" xyz="0.023656 0.119757 0.038947"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_003_Wiring_holder_v1_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- J2: 肩部 → 大臂 (shoulder pitch) -->
  <joint name="J2_Shoulder_Pitch" type="revolute">
    <origin rpy="0 0 0" xyz="-0.023656 -0.119757 -0.038947"/>
    <parent link="shoulder"/>
    <child link="arm_upper"/>
    <axis xyz="0.99996 -0.000076 0.008726"/>
    <limit effort="10" lower="-1.57" upper="1.57" velocity="5"/>
    <dynamics damping="0.1"/>
  </joint>
  <!-- ============================================ -->
  <!-- arm_lower (CAD: upper_arm) — 小臂              -->
  <!-- 嵌入舵机 mesh: part_088(舵机3)                   -->
  <!-- CAD: driver_3_joint origin [0.0139,0.1485,-0.0736] -->
  <!-- ============================================ -->
  <link name="arm_lower">
    <inertial>
      <origin rpy="0 0 0" xyz="0.017605 0.000673 -0.056114"/>
      <mass value="0.11085"/>
      <inertia ixx="0.00010673" ixy="0.00000023" ixz="0.00000165" iyy="0.00014075" iyz="0.00000278" izz="0.00004415"/>
    </inertial>
    <!-- 小臂主体 -->
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0.013895 0.148458 -0.073566"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_004_Wiring_holder_v1_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="so101_light">
        <color rgba="0.35 0.45 0.55 1.0"/>
      </material>
    </visual>
    <!-- 舵机3 (part_088): 驱动 J4, 在 driver_3_joint 处 -->
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0.013895 0.148458 -0.073566"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_088_1653192640_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="servo_grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0" xyz="0.013895 0.148458 -0.073566"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_004_Wiring_holder_v1_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- J3: 大臂 → 小臂 (elbow pitch) -->
  <joint name="J3_Elbow_Pitch" type="revolute">
    <origin rpy="0 0 0" xyz="0.009761 -0.028701 0.112513"/>
    <parent link="arm_upper"/>
    <child link="arm_lower"/>
    <axis xyz="-0.99992 0.008802 -0.008650"/>
    <limit effort="10" lower="-1.57" upper="1.57" velocity="5"/>
    <dynamics damping="0.1"/>
  </joint>
  <!-- ============================================ -->
  <!-- wrist (CAD: Wrist_Roll_Pitch) — 腕部           -->
  <!-- J4 控制, 内含舵机4 (part_089) 在腕部空缺处        -->
  <!-- 参照 SO-100-arm Wrist_Pitch_Roll               -->
  <!-- ============================================ -->
  <link name="wrist">
    <inertial>
      <origin rpy="0 0 0" xyz="0.001941 -0.000195 -0.027095"/>
      <mass value="0.037719"/>
      <inertia ixx="0.00001646" ixy="0.00000022" ixz="0.00000233" iyy="0.00002939" iyz="-0.00000011" izz="0.00001966"/>
    </inertial>
    <!-- 腕部主体 -->
    <visual>
      <origin rpy="1.5707963 0 0" xyz="-0.005534 0.152613 0.060418"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_008_Wiring_holder_v1_1__2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="so101_light">
        <color rgba="0.35 0.45 0.55 1.0"/>
      </material>
    </visual>
    <!-- 舵机4 (part_089): J5 驱动舵机, 放在腕部空缺处, 类似 SO-100-arm 的 wrist 舵机 -->
    <visual>
      <origin rpy="1.5707963 0 0" xyz="-0.005534 0.152613 0.060418"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_089_1653192640_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="servo_grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0" xyz="-0.005534 0.152613 0.060418"/>
      <geometry>
        <mesh filename="package://arm/meshes/body/part_008_Wiring_holder_v1_1__2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- J4: 小臂 → 腕部 (wrist pitch) -->
  <joint name="J4_Wrist_Pitch" type="revolute">
    <origin rpy="0 0 0" xyz="0.019429 -0.004155 -0.133983"/>
    <parent link="arm_lower"/>
    <child link="wrist"/>
    <axis xyz="0.99854 -0.044303 0.030973"/>
    <limit effort="10" lower="-1.57" upper="1.57" velocity="5"/>
    <dynamics damping="0.1"/>
  </joint>
  <!-- ============================================ -->
  <!-- J5: 腕部 → 末端执行器 (wrist roll, Y轴回转)      -->
  <!-- 参照 SO-100-arm Wrist_Roll:                    -->
  <!--   origin: xyz="0 -0.0601 0" rpy="0 1.57079 0" -->
  <!--   axis: xyz="0 1 0"                           -->
  <!-- 第5个舵机驱动末端执行器绕Y轴旋转                     -->
  <!-- ============================================ -->
  <!-- ============================================ -->
  <!-- gripper_base — 末端执行器夹爪                    -->
  <!-- 原始CAD rpy="1.5708 0 0"→先绕X-90°(rpy=0),     -->
  <!-- 再绕Z逆时针90° (rpy="0 0 1.5708")               -->
  <!-- ============================================ -->
  <link name="gripper_base">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.000942 -0.005227 -0.000001"/>
      <mass value="0.053358"/>
      <inertia ixx="0.00003626" ixy="-0.00000155" ixz="-0.00000000" iyy="0.00001901" iyz="-0.00000000" izz="0.00003788"/>
    </inertial>
    <!-- 夹爪主体: 绕Z逆时针90° + 原始CAD rpy补偿 -->
    <visual>
      <origin rpy="0 0 1.5707963" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm/meshes/end_effector/part_002_solid_002.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gripper_dark">
        <color rgba="0.2 0.25 0.3 1.0"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 1.5707963" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm/meshes/end_effector/part_001_solid_001.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gripper_light">
        <color rgba="0.25 0.3 0.35 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm/meshes/end_effector/part_002_solid_002.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- J5: wrist → gripper_base, 绕Y轴回转, 参照 SO-100-arm Wrist_Roll
         末端执行器平移到第5个舵机(part_089)右侧 (wrist X+) -->
  <joint name="J5_Wrist_Roll" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 -0.059"/>
    <parent link="wrist"/>
    <child link="gripper_base"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" lower="-1.57" upper="1.57" velocity="5"/>
    <dynamics damping="0.1"/>
  </joint>
  <!-- ============================================ -->
  <!-- end_effector — 工具点 (TCP)                    -->
  <!-- ============================================ -->
  <link name="end_effector">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>
  <!-- TCP 沿夹爪开口方向 -->
  <joint name="end_effector_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="end_effector"/>
    <origin rpy="0 0 0" xyz="0 0 -0.05"/>
  </joint>
</robot>
