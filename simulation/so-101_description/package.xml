<?xml version="1.0"?>
<package format="3">
  <name>so-101_description</name>
  <version>0.0.0</version>
  <description>SO-101 5DOF 机械臂 URDF 模型、RViz 可视化与 MoveIt2 运动规划配置</description>
  <maintainer email="miwusenlin.g@qq.com">fog</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 核心依赖 -->
  <depend>rclcpp</depend>
  <depend>urdf</depend>
  <depend>xacro</depend>

  <!-- 可视化与仿真 -->
  <depend>rviz2</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_plugins</depend>
  <depend>gazebo_ros2_control</depend>
  <depend>controller_manager</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>

  <!-- MoveIt2 -->
  <depend>moveit_core</depend>
  <depend>moveit_ros_move_group</depend>
  <depend>moveit_ros_visualization</depend>
  <depend>moveit_configs_utils</depend>
  <depend>moveit_simple_controller_manager</depend>
  <depend>rclpy</depend>

  <!-- TF -->
  <depend>tf2_ros</depend>
  <depend>moveit_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>rqt_image_view</exec_depend>

  <!-- Python launch -->
  <exec_depend>python3-xacro</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
