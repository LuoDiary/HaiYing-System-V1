  <model name="custom_quad_333_v9_2">
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.3</mass>
        <inertia>
          <ixx>0.0446583333333</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0446583333333</iyy>
          <iyz>0</iyz>
          <izz>0.0846783333333</izz>
