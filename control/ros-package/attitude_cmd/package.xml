<package format="3">
  <name>attitude_cmd</name>
  <version>0.1.0</version>
  <description>ROS2 node connecting to PX4 (x-mav/ap-h743r1) over TELEM serial + MAVLink for attitude control</description>
  <maintainer email="dev@example.com">dev</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>pymavlink</exec_depend>
  <exec_depend>pyserial</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
